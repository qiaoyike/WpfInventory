<UserControl x:Class="WpfInventory.App.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="审计日志" FontSize="20" FontWeight="Bold" />
            <Button Content="刷新" Command="{Binding LoadCommand}" Margin="16,0,0,0" Padding="12,4" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="用户" Binding="{Binding Username}" Width="120" />
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="160" />
                <DataGridTextColumn Header="实体" Binding="{Binding EntityName}" Width="140" />
                <DataGridTextColumn Header="实体Id" Binding="{Binding EntityId}" Width="80" />
                <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="*" />
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
<UserControl x:Class="WpfInventory.App.Views.RoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="角色列表" FontSize="16" FontWeight="Bold" />
                <Button Content="刷新" Command="{Binding LoadCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="*" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="角色表单" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
            <TextBlock Text="编码" Margin="0,0,0,4" />
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Text="名称" Margin="0,0,0,4" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Text="描述" Margin="0,0,0,4" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

            <TextBlock Text="权限" Margin="0,0,0,4" />
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,10" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PermissionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Permission.Name}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="新增" Command="{Binding PrepareCreateCommand}" Padding="10,4" />
                <Button Content="保存" Command="{Binding SaveCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="删除" Command="{Binding DeleteCommand}" Padding="10,4" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
<UserControl x:Class="WpfInventory.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="报表中心" FontSize="20" FontWeight="Bold" />
            <Button Content="刷新" Command="{Binding LoadCommand}" Margin="16,0,0,0" Padding="12,4" />
        </StackPanel>

        <TabControl>
            <TabItem Header="商品库存报表">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top"
                            Content="导出 CSV"
                            Command="{Binding ExportProductStockCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding ProductStockReport}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="分类" Binding="{Binding CategoryName}" Width="*" />
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="100" />
                            <DataGridTextColumn Header="库存" Binding="{Binding StockQuantity}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="库存流水报表">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top"
                            Content="导出 CSV"
                            Command="{Binding ExportStockTransactionsCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding StockTransactionReport}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="商品" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="仓库" Binding="{Binding WarehouseName}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TransactionType}" Width="90" />
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="80" />
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="100" />
                            <DataGridTextColumn Header="单据号" Binding="{Binding ReferenceNo}" Width="*" />
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
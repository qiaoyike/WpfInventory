<Window x:Class="WpfInventory.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfInventory 库存管理系统"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2C3E50">
            <DockPanel Margin="16,0">
                <TextBlock Text="WpfInventory"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentUserDisplayName}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button Content="退出登录"
                            Command="{Binding LogoutCommand}"
                            Padding="10,4" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 左侧导航 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#34495E">
            <ListBox ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedItem}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="14">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 右侧内容区：根据 CurrentViewModel 自动选择 View -->
        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="16" />
    </Grid>
</Window>
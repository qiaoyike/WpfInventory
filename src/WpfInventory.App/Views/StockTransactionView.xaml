<UserControl x:Class="WpfInventory.App.Views.StockTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Background="#F5F6FA" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="新增库存流水" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="商品" />
                        <ComboBox ItemsSource="{Binding Products}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ProductId}" />
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="仓库" />
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding WarehouseId}" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,8">
                        <TextBlock Text="类型" />
                        <ComboBox ItemsSource="{Binding TransactionTypes}"
                                  SelectedItem="{Binding TransactionType}" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,12,8">
                        <TextBlock Text="数量" />
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,8">
                        <TextBlock Text="单价" />
                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="单据号" />
                        <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="备注" />
                        <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="新增流水" Command="{Binding CreateCommand}" Padding="12,4" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="库存流水列表" FontSize="16" FontWeight="Bold" />
                <Button Content="刷新" Command="{Binding LoadCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="商品" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="仓库" Binding="{Binding WarehouseName}" Width="*" />
                    <DataGridTextColumn Header="类型" Binding="{Binding TransactionTypeName}" Width="90" />
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="80" />
                    <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="100" />
                    <DataGridTextColumn Header="单据号" Binding="{Binding ReferenceNo}" Width="*" />
                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
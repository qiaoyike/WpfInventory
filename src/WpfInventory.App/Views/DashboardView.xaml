<UserControl x:Class="WpfInventory.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="仪表盘" FontSize="20" FontWeight="Bold" />
            <Button Content="刷新" Command="{Binding LoadCommand}" Margin="16,0,0,0" Padding="12,4" />
        </StackPanel>

        <WrapPanel>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#3498DB" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="商品数" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.ProductCount}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#1ABC9C" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="分类数" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.CategoryCount}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#9B59B6" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="仓库数" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.WarehouseCount}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#E67E22" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="供应商数" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.SupplierCount}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#2C3E50" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="客户数" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.CustomerCount}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#27AE60" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="今日入库" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.TodayInboundQuantity}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Width="220" Margin="0,0,16,16" Padding="20" Background="#C0392B" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="今日出库" Foreground="White" Opacity="0.9" />
                    <TextBlock Text="{Binding Summary.TodayOutboundQuantity}" Foreground="White" FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </DockPanel>
</UserControl>